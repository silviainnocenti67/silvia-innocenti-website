# URL del deploy Google Apps Script (Web app). Deve finire in /exec, non /dev.
NEXT_PUBLIC_SCRIPT_URL="https://script.google.com/macros/s/XXXXXXXX/exec"

# ID di misurazione GA4, da Google Analytics > Amministrazione > Flussi di dati.
# Se lasciata vuota, Analytics non viene caricato (utile in locale).
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"